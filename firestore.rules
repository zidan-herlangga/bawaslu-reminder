rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {

      function validNewProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'uid',
                 'nama_lengkap',
                 'email',
                 'divisi',
                 'jabatan',
                 'role_akses',
                 'status_akun',
                 'created_at'
               ])
            && d.uid == userId
            && d.email == request.auth.token.email
            && d.role_akses == 'Staf'
            && d.status_akun == 'Aktif'
            && d.nama_lengkap is string
            && d.nama_lengkap.size() > 0
            && d.nama_lengkap.size() <= 200
            && d.divisi is string
            && d.divisi.size() > 0
            && d.jabatan is string
            && d.jabatan.size() > 0
            && d.created_at is string;
      }

      allow create: if isSelf(userId)
                    && validNewProfile();

      allow read: if isSelf(userId);

      allow update: if isSelf(userId)
                    && request.resource.data.role_akses == resource.data.role_akses
                    && request.resource.data.status_akun == resource.data.status_akun
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == request.auth.token.email;

      allow delete: if false;
    }
  }
}
