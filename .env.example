# Salin file ini menjadi `.env` lalu isi dari Supabase Dashboard.
# Lokasi: Project Settings (ikon gear) > API
#   - Project URL      -> VITE_SUPABASE_URL
#   - publishable key  -> VITE_SUPABASE_ANON_KEY   (format: sb_publishable_...)
#
# Pakai publishable key, BUKAN secret key (sb_secret_...).
# Vite hanya mengekspos variabel yang diawali VITE_ ke browser,
# sehingga secret key tidak boleh ditaruh di sini.
# Setelah mengubah file ini, RESTART dev server (npm run dev).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Notifikasi Web Push (opsional, tapi wajib kalau fitur "Ingatkan" dipakai).
# Jalankan `npm run vapid` lalu tempel kunci PUBLIK saja di sini.
# Kunci privat HANYA untuk server (VAPID_PRIVATE_KEY), jangan pernah pakai awalan VITE_.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# --- Blok server: WAJIB untuk mode lokal ---
# `npm run dev` menjalankan endpoint /api/notify langsung di proses Vite, dan
# endpoint itu membaca nama variabel TANPA awalan VITE_ dari file .env ini.
# Di Vercel blok yang sama diisi di Project > Settings > Environment Variables,
# jadi nilai di kedua tempat HARUS identik (terutama VAPID_PUBLIC_KEY, kalau
# berbeda maka langganan push yang dibuat browser akan ditolak server).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@bawaslu.go.id
# =====================================================================
# Push untuk aplikasi native (folder mobile/)
# =====================================================================

#
# OPSIONAL. Kalau kosong, fitur "Ingatkan" tetap berfungsi untuk pengguna web
# dan hanya perangkat native yang tidak menerima notifikasi. Tidak ada galat,
# hanya catatan di respons endpoint.
#
# Kunci WAJIB disimpan di server saja. Jangan memakai awalan VITE_ atau
# EXPO_PUBLIC_ untuk nilai di bawah, karena keduanya membuat kunci ikut
# terkirim ke perangkat pengguna.
#
# --- Android: Firebase Cloud Messaging ---
#
# 1. console.firebase.google.com, buat project, lalu tambahkan aplikasi Android
#    dengan package id yang sama dengan mobile/app.json: id.bawaslu.bekasi.pengingat
# 2. Project Settings > Service accounts > Generate new private key
# 3. Isi di bawah. Untuk FCM_PRIVATE_KEY, ganti baris baru dengan \n
# 4. Salin google-services.json ke mobile/ (tidak di-commit)
FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- iOS: Apple Push Notification service ---
#
# WAJIB punya Apple Developer Program ($99/tahun). Tanpa itu APNs tidak bisa
# dipakai sama sekali.
#
# 1. Apple Developer > Keys > register APNs Auth Key
# 2. Unduh file .p8 (hanya bisa diunduh sekali)
# 3. Isi Key ID dan Team ID di bawah
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=id.bawaslu.bekasi.pengingat
# Untuk APNS_PRIVATE_KEY, ganti baris baru dengan \n
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
