# Salin file ini menjadi `.env` lalu isi dari Supabase Dashboard.
# Lokasi: Project Settings (ikon gear) > API
#   - Project URL      -> VITE_SUPABASE_URL
#   - publishable key  -> VITE_SUPABASE_ANON_KEY   (format: sb_publishable_...)
#
# Pakai publishable key, BUKAN secret key (sb_secret_...).
# Vite hanya mengekspos variabel yang diawali VITE_ ke browser,
# sehingga secret key tidak boleh ditaruh di sini.
# Setelah mengubah file ini, RESTART dev server (npm run dev).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Notifikasi Web Push (opsional, tapi wajib kalau fitur "Ingatkan" dipakai).
# Jalankan `npm run vapid` lalu tempel kunci PUBLIK saja di sini.
# Kunci privat HANYA untuk Vercel (VAPID_PRIVATE_KEY), jangan pernah pakai awalan VITE_.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
