{
  "expo": {
    "name": "Bawaslu Jadwal",
    "slug": "bawaslu-bekasi-jadwal",
    "scheme": "bawaslu-jadwal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#E02401",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.bawaslu.bekasi.pengingat",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "id.bawaslu.bekasi.pengingat",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "bawaslu-jadwal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E02401",
          "defaultChannel": "pengingat-jadwal",
          "icon": "./assets/notification-icon.png",
          "sounds": [
            "./assets/sounds/notification.wav",
            "./assets/sounds/rapat.wav",
            "./assets/sounds/tugas.wav",
            "./assets/sounds/pengawasan.wav"
          ]
        }
      ],
      "expo-calendar",
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F3",
          "dark": {
            "backgroundColor": "#0E0C0A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6d58d52-42c8-40f4-bff4-5b601769ce16"
      }
    }
  }
}
